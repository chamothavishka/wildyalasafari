# ============================================================================
# Wild Yala Safari — server configuration
# Copy this file to ".env" (never commit .env) and fill in YOUR OWN values.
# On a hosting platform, set these as environment variables instead of using a file.
# Everything below is a placeholder.
# ============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=production
PORT=4000
# The public address of the website, no trailing slash. Used for the payment return / notify URLs and e-mail links.
# PayHere must be able to reach it from the internet (https in production).
SITE_URL=https://wildyalasafari.com
# Reverse-proxy hops to trust for client IPs (1 on Render / Railway / Fly / nginx; 0 if the app is exposed directly).
TRUST_PROXY=1
# Only needed if the website is hosted on a DIFFERENT origin than this server (comma-separated). Normally leave empty.
CORS_ORIGINS=https://wildyalasafari.com,https://www.wildyalasafari.com

# --- MongoDB -----------------------------------------------------------------
# e.g. a MongoDB Atlas connection string:  mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/wild-yala-safari?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/wild-yala-safari?retryWrites=true&w=majority

# --- Sessions (sign-in) --------------------------------------------------------
# A long random secret (32+ characters). Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- PayHere payment gateway ---------------------------------------------------
# From your PayHere merchant account. Use "sandbox" with sandbox credentials while testing, "live" with live credentials.
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Optional: only if the public notify URL differs from SITE_URL/api/payments/payhere/notify (e.g. a tunnel while testing)
PAYHERE_NOTIFY_URL=

# --- E-mail (SMTP) ---------------------------------------------------------------
# Any SMTP provider (your own domain mailbox, Brevo, Mailgun, SendGrid SMTP, Gmail app password, …).
EMAIL_HOST=
EMAIL_PORT=587
# true for port 465, false for 587 (STARTTLS)
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# The sender customers see, e.g.  Wild Yala Safari <bookings@your-domain.com>
EMAIL_FROM=

# --- Optional tuning (defaults shown) ---------------------------------------------
# RATE_LIMIT_API=240        # requests / minute / IP
# RATE_LIMIT_BOOKING=30     # booking attempts / hour / IP
# RATE_LIMIT_LOGIN=10       # sign-in attempts / 15 min / IP + e-mail
# RATE_LIMIT_RESET=8        # password-reset requests / hour / IP
# PASSWORD_RESET_TTL_MINUTES=60

# --- Website build (browser-visible; no secrets!) ------------------------------------
# Leave unset when the website and API share one origin (the default). Only set if the API lives elsewhere:
# VITE_API_BASE_URL=https://api.your-domain.com
# VITE_AUTH_LOGIN_URL=https://api.your-domain.com/api/auth/login
# VITE_AUTH_RESET_URL=https://api.your-domain.com/api/auth/password-reset

# Optional (existing feature): an endpoint that receives guest gallery photos (multipart/form-data: photo, name, caption).
# Leave empty to keep photos on the visitor's own device only.
VITE_GALLERY_UPLOAD_URL=

{
  "name": "wild-yala-safari",
  "private": true,
  "version": "1.0.0",
  "description": "Wild Yala Safari — premium cinematic 3D safari website with a booking, payment (PayHere), MongoDB and e-mail backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "build:esbuild": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs --serve",
    "start": "node server/index.js",
    "user:create": "node server/scripts/create-user.js",
    "emails:retry": "node server/scripts/retry-emails.js",
    "test": "node --test --test-concurrency=2 src/lib/pricing.test.js \"server/test/*.test.js\"",
    "check": "node server/scripts/check-setup.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "mailparser": "^3.10.0",
    "mongodb-memory-server": "^11.3.0",
    "smtp-server": "^3.20.2",
    "supertest": "^7.3.1",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}

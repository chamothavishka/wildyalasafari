# Build-time settings for the website (`npm run build`). These are PUBLIC values compiled into the page — no secrets here.
# The website and the API are served from the same origin, so relative URLs are all that is needed.
VITE_AUTH_LOGIN_URL=/api/auth/login
VITE_AUTH_RESET_URL=/api/auth/password-reset

# VITE_API_BASE_URL=https://api.your-domain.com
